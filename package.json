{
  "name": "namma-city",
  "version": "1.0.0",
  "private": true,
  "description": "Namma City — Mobile-first unified civic services platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace=packages/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=packages/database",
    "prisma:seed": "npm run prisma:seed --workspace=packages/database"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
